// Prisma Schema pour Clinique Betesda — Système de gestion de clinique médicale

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// CLINIC & MULTI-CLINIQUE READY
// -------------------------------------------------------------

model Clinic {
  id               String            @id @default(uuid()) @db.VarChar(36)
  name             String            @default("Clinique Betesda") @db.VarChar(150)
  slug             String            @unique @default("betesda") @db.VarChar(100)
  slogan           String?           @default("La gestion intelligente de votre clinique") @db.VarChar(255)
  logoUrl          String?           @default("/logo/betesda-logo.svg") @db.VarChar(255)
  address          String?           @default("Lot IVG 35 Antananarivo, Madagascar") @db.VarChar(255)
  phone            String?           @default("+261 20 22 123 45") @db.VarChar(50)
  email            String?           @default("contact@cliniquebetesda.mg") @db.VarChar(150)
  website          String?           @default("https://cliniquebetesda.mg") @db.VarChar(150)
  taxId            String?           @default("NIF: 3000123456 / STAT: 85111") @db.VarChar(100)
  currency         String            @default("Ar") @db.VarChar(20)
  dateFormat       String            @default("DD/MM/YYYY") @db.VarChar(20)
  timeZone         String            @default("Indian/Antananarivo") @db.VarChar(50)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  patients         Patient[]
  doctors          Doctor[]
  medicines        Medicine[]
  suppliers        Supplier[]
  invoices         Invoice[]
  pharmacySales    PharmacySale[]
  cashTransactions CashTransaction[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settings         Setting[]
  chatMessages     ChatMessage[]
  pharmacyInventories PharmacyInventory[]
  consumableDeliveries ConsumableDelivery[]
  consumableCatalogItems ConsumableCatalogItem[]
  payrollSlips             PayrollSlip[]
  clinicMedicineRequisitions ClinicMedicineRequisition[]
  employees                Employee[]
  dentalActs               DentalAct[]
  @@map("clinic")
}

// -------------------------------------------------------------
// UTILISATEURS, RÔLES & PERMISSIONS (RBAC)
// -------------------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  RECEPTIONIST
  ACCOUNTANT
}

model Role {
  id          String           @id @default(uuid()) @db.VarChar(36)
  name        RoleType         @unique
  displayName String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  module      String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]
  @@map("permission")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       String     @db.VarChar(36)
  permissionId String     @db.VarChar(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("rolepermission")
}

model User {
  id               String            @id @default(uuid()) @db.VarChar(36)
  email            String            @unique @db.VarChar(191)
  passwordHash     String            @db.VarChar(255)
  firstName        String            @db.VarChar(100)
  lastName         String            @db.VarChar(100)
  phone            String?           @db.VarChar(50)
  avatar           String?           @db.VarChar(255)
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  clinicId         String            @db.VarChar(36)
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  roleId           String            @db.VarChar(36)
  role             Role              @relation(fields: [roleId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  doctorProfile    Doctor?
  auditLogs        AuditLog[]
  notifications    Notification[]
  cashTransactions CashTransaction[]
  payrollSlips     PayrollSlip[]
  sentMessages     ChatMessage[]     @relation("SentMessages")
  receivedMessages ChatMessage[]     @relation("ReceivedMessages")

  @@index([email])
  @@index([clinicId])
  @@map("user")
}

// -------------------------------------------------------------
// MÉDECINS & SPÉCIALITÉS
// -------------------------------------------------------------

model Specialty {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  doctors     Doctor[]
  createdAt   DateTime @default(now())
  @@map("specialty")
}

model Doctor {
  id            String         @id @default(uuid()) @db.VarChar(36)
  userId        String?        @unique @db.VarChar(36)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinicId      String         @db.VarChar(36)
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  firstName     String?        @db.VarChar(80)
  lastName      String?        @db.VarChar(80)
  title         String?        @default("Dr.") @db.VarChar(50)
  licenseNumber String?        @db.VarChar(100)
  specialtyId   String?        @db.VarChar(36)
  specialty     Specialty?     @relation(fields: [specialtyId], references: [id])
  specialtyName String?        @db.VarChar(100)
  phone         String?        @db.VarChar(50)
  email         String?        @db.VarChar(150)
  bio           String?        @db.Text
  workingHours  String?        @default("Lun - Ven: 08h00 - 17h00") @db.VarChar(100)
  stampUrl      String?        @db.VarChar(255)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
  patients      Patient[]      @relation("PrimaryDoctor")

  @@index([clinicId])
  @@index([specialtyId])
  @@map("doctor")
}

// -------------------------------------------------------------
// PATIENTS & DOSSIER MÉDICAL
// -------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id                     String            @id @default(uuid()) @db.VarChar(36)
  clinicId               String            @db.VarChar(36)
  clinic                 Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientNumber          String            @unique @db.VarChar(50)
  firstName              String            @db.VarChar(80)
  lastName               String            @db.VarChar(80)
  gender                 Gender            @default(MALE)
  birthDate              DateTime
  bloodGroup             String?           @default("O+") @db.VarChar(10)
  phone                  String            @db.VarChar(50)
  email                  String?           @db.VarChar(150)
  address                String?           @db.VarChar(255)
  city                   String?           @default("Antananarivo") @db.VarChar(100)
  idCardNumber           String?           @db.VarChar(50)
  emergencyContactName   String?           @db.VarChar(150)
  emergencyContactPhone  String?           @db.VarChar(50)
  emergencyContactRel    String?           @db.VarChar(50)
  photoUrl               String?           @db.VarChar(255)
  primaryDoctorId        String?           @db.VarChar(36)
  primaryDoctor          Doctor?           @relation("PrimaryDoctor", fields: [primaryDoctorId], references: [id])
  isActive               Boolean           @default(true)
  deletedAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  medicalRecord          MedicalRecord?
  appointments           Appointment[]
  consultations          Consultation[]
  prescriptions          Prescription[]
  invoices               Invoice[]
  documents              PatientDocument[]
  pharmacySales          PharmacySale[]
  consumableDeliveries   ConsumableDelivery[]

  @@index([clinicId])
  @@index([patientNumber])
  @@index([lastName])
  @@index([firstName])
  @@index([phone])
  @@map("patient")
}

model MedicalRecord {
  id               String   @id @default(uuid()) @db.VarChar(36)
  patientId        String   @unique @db.VarChar(36)
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies        String?  @db.Text
  chronicDiseases  String?  @db.Text
  surgicalHistory  String?  @db.Text
  familyHistory    String?  @db.Text
  habits           String?  @db.Text
  bloodTransfusion Boolean  @default(false)
  generalNotes     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@map("medicalrecord")
}

enum DocumentCategory {
  LAB_REPORT
  XRAY_IMAGING
  PRESCRIPTION
  MEDICAL_CERTIFICATE
  DISCHARGE_SUMMARY
  OTHER
}

model PatientDocument {
  id          String           @id @default(uuid()) @db.VarChar(36)
  patientId   String           @db.VarChar(36)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String           @db.VarChar(150)
  category    DocumentCategory @default(LAB_REPORT)
  fileUrl     String           @db.VarChar(255)
  fileType    String?          @default("application/pdf") @db.VarChar(50)
  fileSize    Int?
  uploadedBy  String?          @db.VarChar(100)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([patientId])
  @@map("patientdocument")
}

// -------------------------------------------------------------
// RENDEZ-VOUS
// -------------------------------------------------------------

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid()) @db.VarChar(36)
  patientId       String            @db.VarChar(36)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String            @db.VarChar(36)
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate DateTime
  startTime       String            @db.VarChar(10)
  endTime         String?           @db.VarChar(10)
  status          AppointmentStatus @default(PENDING)
  reason          String?           @db.VarChar(255)
  notes           String?           @db.Text
  consultation    Consultation?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([doctorId])
  @@index([appointmentDate])
  @@index([patientId])
  @@index([status])
  @@map("appointment")
}

// -------------------------------------------------------------
// CONSULTATIONS & CONSTANTES VITALES
// -------------------------------------------------------------

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Consultation {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  patientId           String             @db.VarChar(36)
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String?            @db.VarChar(36)
  doctor              Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  appointmentId       String?            @unique @db.VarChar(36)
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id])
  consultationDate    DateTime           @default(now())
  reason              String             @db.VarChar(255)
  symptoms            String?            @db.Text
  physicalExamination String?            @db.Text
  diagnosis           String?            @db.Text
  treatment           String?            @db.Text
  doctorNotes         String?            @db.Text
  status              ConsultationStatus @default(COMPLETED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  vitalSigns          VitalSign?
  prescription        Prescription?
  invoice             Invoice?

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationDate])
  @@map("consultation")
}

model VitalSign {
  id               String       @id @default(uuid()) @db.VarChar(36)
  consultationId   String       @unique @db.VarChar(36)
  consultation     Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  temperature      Float?
  systolicBP       Int?
  diastolicBP      Int?
  heartRate        Int?
  oxygenSaturation Float?
  weight           Float?
  height           Float?
  bmi              Float?
  measuredAt       DateTime     @default(now())
  @@map("vitalsign")
}

// -------------------------------------------------------------
// ORDONNANCES MÉDICALES
// -------------------------------------------------------------

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  CANCELLED
}

model Prescription {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  prescriptionNumber String             @unique @db.VarChar(50)
  patientId          String             @db.VarChar(36)
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String             @db.VarChar(36)
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultationId     String?            @unique @db.VarChar(36)
  consultation       Consultation?      @relation(fields: [consultationId], references: [id])
  status             PrescriptionStatus @default(ACTIVE)
  qrCode             String?            @db.Text
  doctorNotes        String?            @db.Text
  validUntil         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              PrescriptionItem[]
  pharmacySales      PharmacySale[]

  @@index([patientId])
  @@index([doctorId])
  @@index([prescriptionNumber])
  @@map("prescription")
}

model PrescriptionItem {
  id             String       @id @default(uuid()) @db.VarChar(36)
  prescriptionId String       @db.VarChar(36)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?      @db.VarChar(36)
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  medicineName   String       @db.VarChar(150)
  dosage         String       @db.VarChar(100)
  form           String       @db.VarChar(100)
  quantity       Int          @default(1)
  frequency      String       @db.VarChar(100)
  duration       String       @db.VarChar(100)
  route          String?      @default("Voie orale") @db.VarChar(100)
  instructions   String?      @db.VarChar(255)

  @@index([prescriptionId])
  @@map("prescriptionitem")
}

// -------------------------------------------------------------
// PHARMACIE, MÉDICAMENTS & GESTION DES STOCKS
// -------------------------------------------------------------

model MedicineCategory {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(255)
  medicines   Medicine[]
  createdAt   DateTime   @default(now())
  @@map("medicinecategory")
}

model Medicine {
  id                String             @id @default(uuid()) @db.VarChar(36)
  clinicId          String             @db.VarChar(36)
  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name              String             @db.VarChar(100)
  genericName       String             @db.VarChar(100)
  categoryId        String             @db.VarChar(36)
  category          MedicineCategory   @relation(fields: [categoryId], references: [id])
  manufacturer      String?            @db.VarChar(150)
  dosage            String             @db.VarChar(100)
  form              String             @db.VarChar(100)
  packaging         String?            @default("Boîte") @db.VarChar(50)
  unitsPerBox       Int                @default(1)
  purchasePrice     Float
  sellingPrice      Float
  currentStock      Int                @default(0)
  minStockLevel     Int                @default(10)
  expiryDate        DateTime?
  location          String?            @default("Rayon A - Tiroir 1") @db.VarChar(100)
  barcode           String?            @db.VarChar(100)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  prescriptionItems PrescriptionItem[]
  stockEntries      StockEntry[]
  stockExits        StockExit[]
  saleItems         PharmacySaleItem[]
  inventoryItems    PharmacyInventoryItem[]
  consumableItems   ConsumableDeliveryItem[]

  @@index([clinicId])
  @@index([categoryId])
  @@index([name])
  @@index([genericName])
  @@map("medicine")
}

model Supplier {
  id            String       @id @default(uuid()) @db.VarChar(36)
  clinicId      String       @db.VarChar(36)
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String       @db.VarChar(150)
  contactPerson String?      @db.VarChar(100)
  phone         String       @db.VarChar(50)
  email         String?      @db.VarChar(150)
  address       String?      @db.VarChar(255)
  taxId         String?      @db.VarChar(100)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  stockEntries  StockEntry[]

  @@index([clinicId])
  @@map("supplier")
}

model StockEntry {
  id             String    @id @default(uuid()) @db.VarChar(36)
  medicineId     String    @db.VarChar(36)
  medicine       Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplierId     String?   @db.VarChar(36)
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  quantity       Int
  boxesCount     Int?
  unitsPerBox    Int?
  attachmentUrl  String?   @db.Text
  attachmentName String?   @db.VarChar(255)
  unitCost       Float
  totalCost      Float
  batchNumber    String?   @db.VarChar(100)
  expiryDate     DateTime?
  entryDate      DateTime  @default(now())
  notes          String?   @db.VarChar(255)
  createdById    String?   @db.VarChar(36)

  @@index([medicineId])
  @@index([supplierId])
  @@map("stockentry")
}

enum StockExitReason {
  EXPIRED
  DAMAGED
  INVENTORY_ADJUSTMENT
  RETURN_TO_SUPPLIER
  OTHER
}

model StockExit {
  id          String          @id @default(uuid()) @db.VarChar(36)
  medicineId  String          @db.VarChar(36)
  medicine    Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity    Int
  reason      StockExitReason @default(EXPIRED)
  exitDate    DateTime        @default(now())
  notes       String?         @db.VarChar(255)
  createdById String?         @db.VarChar(36)

  @@index([medicineId])
  @@map("stockexit")
}

// -------------------------------------------------------------
// VENTE PHARMACIE (POS)
// -------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CREDIT_CARD
  BANK_TRANSFER
}

enum SaleStatus {
  PENDING_PAYMENT
  PAID
  DELIVERED
  COMPLETED
  REFUNDED
  CANCELLED
}

model PharmacySale {
  id               String             @id @default(uuid()) @db.VarChar(36)
  saleNumber       String             @unique @db.VarChar(50)
  clinicId         String             @db.VarChar(36)
  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptionId   String?            @db.VarChar(36)
  prescription     Prescription?      @relation(fields: [prescriptionId], references: [id])
  patientId        String?            @db.VarChar(36)
  patient          Patient?           @relation(fields: [patientId], references: [id])
  customerName     String?            @default("Client de passage") @db.VarChar(150)
  customerPhone    String?            @db.VarChar(50)
  subtotal         Float
  discount         Float              @default(0)
  total            Float
  paymentMethod    PaymentMethod      @default(CASH)
  paymentReference String?            @db.VarChar(100)
  status           SaleStatus         @default(COMPLETED)
  employeeId       String?            @db.VarChar(36)
  isFreeGift       Boolean            @default(false)
  saleDate         DateTime           @default(now())
  cashierId        String?            @db.VarChar(36)
  createdAt        DateTime           @default(now())

  items            PharmacySaleItem[]

  @@index([clinicId])
  @@index([saleNumber])
  @@index([saleDate])
  @@map("pharmacysale")
}

model PharmacySaleItem {
  id             String       @id @default(uuid()) @db.VarChar(36)
  pharmacySaleId String       @db.VarChar(36)
  pharmacySale   PharmacySale @relation(fields: [pharmacySaleId], references: [id], onDelete: Cascade)
  medicineId     String       @db.VarChar(36)
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  medicineName   String       @db.VarChar(150)
  quantity       Int
  unitPrice      Float
  totalPrice     Float

  @@index([pharmacySaleId])
  @@index([medicineId])
  @@map("pharmacysaleitem")
}

// -------------------------------------------------------------
// INVENTAIRE PHARMACIE PERSONNALISÉ
// -------------------------------------------------------------

model PharmacyInventory {
  id                   String                  @id @default(uuid()) @db.VarChar(36)
  clinicId             String                  @db.VarChar(36)
  clinic               Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  inventoryNumber      String                  @unique @db.VarChar(50)
  title                String                  @db.VarChar(150)
  status               String                  @default("VALIDATED") @db.VarChar(30)
  notes                String?                 @db.Text
  totalItemsCount      Int                     @default(0)
  discrepancyCount     Int                     @default(0)
  totalFinancialImpact Float                   @default(0)
  createdById          String?                 @db.VarChar(36)
  createdByName        String?                 @db.VarChar(100)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  items                PharmacyInventoryItem[]

  @@index([clinicId])
  @@index([inventoryNumber])
  @@index([createdAt])
  @@map("pharmacyinventory")
}

model PharmacyInventoryItem {
  id               String            @id @default(uuid()) @db.VarChar(36)
  inventoryId      String            @db.VarChar(36)
  inventory        PharmacyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  medicineId       String            @db.VarChar(36)
  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  medicineName     String            @db.VarChar(150)
  theoreticalStock Int
  countedStock     Int
  difference       Int
  purchasePrice    Float
  financialImpact  Float
  reason           String?           @db.VarChar(255)

  @@index([inventoryId])
  @@index([medicineId])
  @@map("pharmacyinventoryitem")
}

// -------------------------------------------------------------
// DÉLIVRANCE CONSOMMABLES & MATÉRIEL MÉDICAL
// -------------------------------------------------------------

model ConsumableDelivery {
  id              String                   @id @default(uuid()) @db.VarChar(36)
  clinicId        String                   @db.VarChar(36)
  clinic          Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  deliveryNumber  String                   @unique @db.VarChar(50)
  sheetReference  String?                  @db.VarChar(50)
  roomNumber      String?                  @db.VarChar(50)
  fileNumber      String?                  @db.VarChar(50)
  patientId       String?                  @db.VarChar(36)
  patient         Patient?                 @relation(fields: [patientId], references: [id], onDelete: SetNull)
  recipientName   String                   @db.VarChar(150)
  recipientPhone  String?                  @db.VarChar(50)
  patientName     String?                  @db.VarChar(150)
  reason          String?                  @default("Soins infirmiers / Urgences") @db.VarChar(150)
  date            DateTime                 @default(now())
  paymentMethod   PaymentMethod            @default(CASH)
  paymentStatus   String                   @default("PAID") @db.VarChar(30)
  subtotal        Float                    @default(0)
  totalAmount     Float                    @default(0)
  notes           String?                  @db.Text
  deliveredById   String?                  @db.VarChar(36)
  deliveredByName String?                  @db.VarChar(100)
  status          String                   @default("COMPLETED") @db.VarChar(30)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  items           ConsumableDeliveryItem[]

  @@index([clinicId])
  @@index([deliveryNumber])
  @@index([sheetReference])
  @@index([recipientName])
  @@index([patientId])
  @@index([createdAt])
  @@map("consumabledelivery")
}

model ConsumableDeliveryItem {
  id          String             @id @default(uuid()) @db.VarChar(36)
  deliveryId  String             @db.VarChar(36)
  delivery    ConsumableDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  category    String             @default("MEDICAMENT") @db.VarChar(50)
  medicineId  String?            @db.VarChar(36)
  medicine    Medicine?          @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  itemName    String             @db.VarChar(150)
  itemDate    DateTime?          @default(now())
  unit        String?            @default("Pièce") @db.VarChar(50)
  quantity    Int                @default(1)
  unitPrice   Float              @default(0)
  totalPrice  Float              @default(0)
  orderIndex  Int                @default(0)

  @@index([deliveryId])
  @@index([medicineId])
  @@index([category])
  @@map("consumabledeliveryitem")
}

model ConsumableCatalogItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  clinicId    String   @db.VarChar(36)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  category    String   @db.VarChar(50) // "MEDICAMENT", "ACTE_INFIRMIER", "HEBERGEMENT", "AUTRE"
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  unit        String?  @default("U") @db.VarChar(50)
  price       Float    @default(0)
  medicineId  String?  @db.VarChar(36)
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
  @@index([category])
  @@map("consumablecatalogitem")
}

// -------------------------------------------------------------
// FACTURATION, PAIEMENTS & CAISSE
// -------------------------------------------------------------

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid()) @db.VarChar(36)
  invoiceNumber  String        @unique @db.VarChar(50)
  clinicId       String        @db.VarChar(36)
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String        @db.VarChar(36)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?       @unique @db.VarChar(36)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  totalAmount    Float
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  paidAmount     Float         @default(0)
  balance        Float         @default(0)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime?
  issuedDate     DateTime      @default(now())
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          InvoiceItem[]
  payments       Payment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoice")
}

enum InvoiceItemType {
  CONSULTATION
  SPECIALIST_CONSULTATION
  MEDICAL_PROCEDURE
  LABORATORY_TEST
  PHARMACY
  ROOM_HOSPITALIZATION
  OTHER_SERVICE
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.VarChar(36)
  invoiceId   String          @db.VarChar(36)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String          @db.VarChar(255)
  itemType    InvoiceItemType @default(CONSULTATION)
  quantity    Int             @default(1)
  unitPrice   Float
  totalPrice  Float

  @@index([invoiceId])
  @@map("invoiceitem")
}

model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  paymentNumber String        @unique @db.VarChar(50)
  invoiceId     String        @db.VarChar(36)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod @default(CASH)
  paymentDate   DateTime      @default(now())
  reference     String?       @db.VarChar(100)
  notes         String?       @db.VarChar(255)
  receivedById  String?       @db.VarChar(36)
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@map("payment")
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

model CashTransaction {
  id              String              @id @default(uuid()) @db.VarChar(36)
  clinicId        String              @db.VarChar(36)
  clinic          Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  type            CashTransactionType
  category        String              @db.VarChar(100)
  amount          Float
  paymentMethod   PaymentMethod       @default(CASH)
  reference       String?             @db.VarChar(100)
  description     String              @db.VarChar(255)
  cashRegister    String              @default("PETITE_CAISSE") @db.VarChar(50)
  transactionDate DateTime            @default(now())
  performedById   String?             @db.VarChar(36)
  performedBy     User?               @relation(fields: [performedById], references: [id], onDelete: SetNull)
  attachmentUrl   String?             @db.Text
  attachmentName  String?             @db.VarChar(255)
  createdAt       DateTime            @default(now())

  @@index([clinicId])
  @@index([type])
  @@index([transactionDate])
  @@map("cashtransaction")
}

// -------------------------------------------------------------
// NOTIFICATIONS & AUDIT TRAIL
// -------------------------------------------------------------

enum NotificationType {
  LOW_STOCK
  EXPIRY_WARNING
  APPOINTMENT_REMINDER
  NEW_PATIENT
  NEW_PRESCRIPTION
  PAYMENT_RECEIVED
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  clinicId  String           @db.VarChar(36)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String?          @db.VarChar(36)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String           @db.VarChar(150)
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?          @db.VarChar(255)
  createdAt DateTime         @default(now())

  @@index([clinicId])
  @@index([userId])
  @@map("notification")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  DISPENSE
  PAYMENT
}

model AuditLog {
  id        String      @id @default(uuid()) @db.VarChar(36)
  clinicId  String      @db.VarChar(36)
  clinic    Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String?     @db.VarChar(36)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String      @db.VarChar(100)
  entityId  String?     @db.VarChar(100)
  details   String?     @db.Text
  ipAddress String?     @db.VarChar(50)
  userAgent String?     @db.VarChar(255)
  createdAt DateTime    @default(now())

  @@index([clinicId])
  @@index([entity])
  @@index([createdAt])
  @@map("auditlog")
}

// -------------------------------------------------------------
// PARAMÈTRES DE L'APPLICATION
// -------------------------------------------------------------

model Setting {
  id        String   @id @default(uuid()) @db.VarChar(36)
  clinicId  String   @db.VarChar(36)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(80)
  value     String   @db.Text
  category  String   @default("general") @db.VarChar(50)
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([clinicId, key])
  @@map("setting")
}

// -------------------------------------------------------------
// MESSAGERIE INTERNE (CHAT INTER-UTILISATEURS)
// -------------------------------------------------------------

model ChatMessage {
  id         String    @id @default(uuid()) @db.VarChar(36)
  clinicId   String    @db.VarChar(36)
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  senderId   String    @db.VarChar(36)
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String    @db.VarChar(36)
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String    @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([clinicId])
  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@index([createdAt])
  @@map("chatmessage")
}

// -------------------------------------------------------------
// FICHES DE PAIE & SALAIRES DU PERSONNEL
// -------------------------------------------------------------

model PayrollSlip {
  id               String        @id @default(uuid()) @db.VarChar(36)
  clinicId         String        @db.VarChar(36)
  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId           String?       @db.VarChar(36)
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String?       @db.VarChar(36)
  employee         Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName     String?       @db.VarChar(150)
  employeePosition String?       @db.VarChar(100)
  slipNumber       String        @unique @db.VarChar(50)
  month            String        @db.VarChar(20)
  monthLabel       String        @db.VarChar(50)
  baseSalary       Float
  bonusAmount      Float         @default(0)
  deductionAmount  Float         @default(0)
  netSalary        Float
  paymentMethod    PaymentMethod @default(BANK_TRANSFER)
  paymentDate      DateTime      @default(now())
  status           String        @default("PAID") @db.VarChar(30)
  notes            String?       @db.Text
  transactionId    String?       @db.VarChar(36)
  createdAt        DateTime      @default(now())

  @@index([clinicId])
  @@index([userId])
  @@index([employeeId])
  @@index([month])
  @@map("payrollslip")
}

// -------------------------------------------------------------
// DÉPENSE CLINIQUE : PRÉLÈVEMENT MÉDICAMENTS PHARMACIE
// -------------------------------------------------------------

model ClinicMedicineRequisition {
  id                String   @id @default(uuid()) @db.VarChar(36)
  clinicId          String   @db.VarChar(36)
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  requisitionNumber String   @unique @db.VarChar(50)
  department        String   @db.VarChar(100)
  requestedBy       String   @db.VarChar(150)
  reason            String   @db.VarChar(255)
  totalCost         Float
  date              DateTime @default(now())
  notes             String?  @db.Text
  itemsJson         String   @db.Text
  attachmentUrl     String?  @db.Text
  attachmentName    String?  @db.VarChar(255)
  transactionId     String?  @db.VarChar(36)
  createdAt         DateTime @default(now())

  @@index([clinicId])
  @@index([requisitionNumber])
  @@map("clinicmedicinerequisition")
}

// -------------------------------------------------------------
// EMPLOYÉS DU PERSONNEL (HORS COMPTES SYSTÈME)
// -------------------------------------------------------------

model Employee {
  id           String        @id @default(uuid()) @db.VarChar(36)
  clinicId     String        @db.VarChar(36)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lastName     String        @db.VarChar(100)
  firstName    String        @db.VarChar(100)
  phone        String?       @db.VarChar(50)
  position     String        @db.VarChar(100)
  baseSalary   Float         @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  payrollSlips PayrollSlip[]

  @@index([clinicId])
  @@map("employee")
}

// -------------------------------------------------------------
// CABINET DENTAIRE : ACTIONS & TARIFS DES SOINS
// -------------------------------------------------------------

model DentalAct {
  id          String   @id @default(uuid()) @db.VarChar(36)
  clinicId    String   @db.VarChar(36)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(150)
  price       Float
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clinicId])
  @@map("dentalact")
}


